# Shirley & the Shark — shared hosting config
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # api/* → api.php (relative pattern, works from a subfolder too)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api.php?p=api/$1 [QSA,L]
</IfModule>

# never serve the database
<FilesMatch "\.(db|db-wal|db-shm|sqlite)$">
  Require all denied
</FilesMatch>
